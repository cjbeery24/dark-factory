ARG NODE_IMAGE
FROM ${NODE_IMAGE}

ARG BASH_VERSION
ARG COREUTILS_VERSION
ARG GIT_VERSION
ARG PNPM_VERSION
ARG PYTHON3_VERSION
RUN apk add --no-cache \
    bash=${BASH_VERSION} \
    coreutils=${COREUTILS_VERSION} \
    git=${GIT_VERSION} \
    python3=${PYTHON3_VERSION} \
 && npm install -g pnpm@${PNPM_VERSION} --no-fund --no-update-notifier

COPY docker/lockfiles/claude-code/package.json docker/lockfiles/claude-code/package-lock.json /opt/claude-code/
WORKDIR /opt/claude-code
RUN npm ci --production
ENV PATH="/opt/claude-code/node_modules/.bin:$PATH"

COPY scripts/quality-gate.sh /opt/dark-factory/scripts/quality-gate.sh
COPY scripts/workspace-check.py /opt/dark-factory/scripts/workspace-check.py
COPY scripts/lib/ /opt/dark-factory/scripts/lib/

RUN mkdir -p /home/agent && chmod 777 /home/agent
RUN mkdir -p /pnpm-store && chown 1000:1000 /pnpm-store

WORKDIR /workspace

ENTRYPOINT ["claude", "-p", "--dangerously-skip-permissions"]
