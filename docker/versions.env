# Dark Factory — Pinned Dependency Versions
# ==========================================
# Update process:
#   1. Run: bash docker/update-pins.sh   (prints current latest — review and copy here)
#   2. Rebuild: bash docker/build-images.sh [language]
#      Verification runs automatically; fails loudly on mismatch.

# ---- Base images (digest-pinned, immutable) ----
# docker pull node:22-alpine && docker inspect node:22-alpine --format='{{index .RepoDigests 0}}'
NODE_IMAGE="node:22-alpine@sha256:e4bf2a82ad0a4037d28035ae71529873c069b13eb0455466ae0bc13363826e34"
# docker pull alpine:3.19 && docker inspect alpine:3.19 --format='{{index .RepoDigests 0}}'
ALPINE_IMAGE="alpine:3.19@sha256:6baf43584bcb78f2e5847d1de515f23499913ac9f12bdf834811a3145eb11ca1"

# ---- Claude Code (MOST CRITICAL — runs with --dangerously-skip-permissions) ----
# npm show @anthropic-ai/claude-code version
CLAUDE_CODE_VERSION="2.1.63"

# ---- Base OS packages (apk, from pinned node image) ----
# docker run --rm "${NODE_IMAGE}" sh -c 'apk update -q && apk search -x bash coreutils git py3-yaml'
BASH_VERSION="5.3.3-r1"
COREUTILS_VERSION="9.8-r1"
GIT_VERSION="2.52.0-r0"
# py3-yaml is required by scripts/lib/render_import_contract_phase.py
# (runs inside dark-factory-base; no pip path available there).
PY3_YAML_VERSION="6.0.3-r0"

# ---- tinyproxy (apk, from pinned alpine image) ----
# docker run --rm "${ALPINE_IMAGE}" sh -c 'apk update -q && apk search -x tinyproxy'
TINYPROXY_VERSION="1.11.2-r0"

# ---- Node.js tooling ----
# npm show typescript version; npm show eslint version; npm show prettier version; npm show pnpm version
TYPESCRIPT_VERSION="5.9.3"
ESLINT_VERSION="10.0.2"
PRETTIER_VERSION="3.8.1"
PNPM_VERSION="9.15.9"

# ---- Python interpreter (apk, from pinned node image) ----
# docker run --rm "${NODE_IMAGE}" sh -c 'apk update -q && apk search -x python3 py3-pip python3-dev'
PYTHON3_VERSION="3.12.13-r0"
PY3_PIP_VERSION="25.1.1-r1"
PYTHON3_DEV_VERSION="3.12.13-r0"

# ---- Debian Python base image (for playwright container) ----
# Used by dark-factory-playwright (Debian-based; playwright manylinux wheels require glibc)
# docker pull python:3.12-slim && docker inspect python:3.12-slim --format='{{index .RepoDigests 0}}'
PYTHON3_SLIM_IMAGE="python:3.12-slim@sha256:3d5ed973e45820f5ba5e46bd065bd88b3a504ff0724d85980dcd05eab361fcf4"

# ---- Python tooling ----
# pip index versions ruff; pip index versions mypy; pip index versions pytest; pip index versions playwright
RUFF_VERSION="0.15.4"
MYPY_VERSION="1.19.1"
PYTEST_VERSION="9.0.2"
PLAYWRIGHT_VERSION="1.50.0"

# ---- Darkfactory runtime deps (installed into dark-factory-python, the
#      substrate verifier image, so adapter module imports resolve the
#      same transitive chain as the orchestrator host). Authoritative
#      ranges live in pyproject.toml [project.dependencies]; pins here
#      are frozen from an Alpine install of those ranges. Keep in sync.
# pip index versions pyyaml; pip index versions markdown-it-py; pip index versions tomli-w; pip index versions psycopg
PYYAML_VERSION="6.0.3"
MARKDOWN_IT_PY_VERSION="3.0.0"
MDURL_VERSION="0.1.2"
TOMLI_W_VERSION="1.2.0"
# psycopg: required by the Postgres adapter's substrate verifier
# (darkfactory.adapters.postgres.adapter). Installs a second pinned
# entry (psycopg-binary) via `psycopg[binary]` extra — regenerate-lockfiles.sh
# captures both because --no-deps would skip the extra otherwise.
PSYCOPG_VERSION="3.3.3"

# ---- Go toolchain (apk, from pinned node image) ----
# docker run --rm "${NODE_IMAGE}" sh -c 'apk update -q && apk search -x go'
GO_VERSION="1.25.7-r0"

# ---- Rust toolchain (apk, from pinned node image) ----
# docker run --rm "${NODE_IMAGE}" sh -c 'apk update -q && apk search -x rust cargo'
RUST_VERSION="1.91.1-r0"
CARGO_VERSION="1.91.1-r0"
