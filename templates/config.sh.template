#!/usr/bin/env bash
# Dark Factory — Per-Project Configuration
# Generated by: scripts/integrate.sh
# This file is sourced by quality-gate.sh, run-scenarios.sh, and dark-factory.sh.
#
# WARNING: This file is sourced by Dark Factory scripts.
# Only define simple variable assignments (VAR="value").
# Do NOT include bare commands, command substitutions, or eval.
#
# Edit the values below to match your project's toolchain.
# Any empty value falls back to auto-detection.

# ==============================================================================
# Language / Toolchain
# ==============================================================================
# Options: "node" | "python" | "go" | "rust" | "unknown"
LANGUAGE="__LANGUAGE__"

# ==============================================================================
# Source and Test Directories
# ==============================================================================
# Where your implementation source code lives (relative to project root).
SOURCE_DIR="__SOURCE_DIR__"

# Where your project's own tests live (not blind scenarios).
TEST_DIR="__TEST_DIR__"

# ==============================================================================
# Build Command
# ==============================================================================
# Command to compile / type-check your project.
#
# Examples:
#   Node/TS:  "npm run build"
#   Python:   "python -m py_compile src/**/*.py"
#   Go:       "go build ./..."
#   Rust:     "cargo build"
BUILD_CMD="__BUILD_CMD__"

# ==============================================================================
# Lint Command
# ==============================================================================
# Command to lint your project.
#
# Examples:
#   Node/TS:  "npm run lint"
#   Python:   "ruff check ."
#   Go:       "golangci-lint run"
#   Rust:     "cargo clippy -- -D warnings"
LINT_CMD="__LINT_CMD__"

# ==============================================================================
# Type Check Command
# ==============================================================================
# Command to run type checking (leave empty if covered by build).
#
# Examples:
#   Node/TS:  "npx tsc --noEmit"
#   Python:   "mypy ."
#   Go:       ""  (covered by go build)
#   Rust:     ""  (covered by cargo build)
TYPECHECK_CMD="__TYPECHECK_CMD__"

# ==============================================================================
# Test Command (project's own tests)
# ==============================================================================
# Command to run the project's self-tests (NOT blind scenarios).
#
# Examples:
#   Node/TS:  "npm test"
#   Python:   "pytest tests/ -v"
#   Go:       "go test ./... -v"
#   Rust:     "cargo test"
TEST_CMD="__TEST_CMD__"

# ==============================================================================
# Scenario Test Command (blind scenarios)
# ==============================================================================
# Command to run blind test scenarios. Use {SCENARIOS_DIR} as a placeholder —
# it will be replaced with the actual scenarios path at runtime.
#
# Examples:
#   Node/TS:  "npx vitest run {SCENARIOS_DIR}"
#   Python:   "pytest {SCENARIOS_DIR} -v"
#   Go:       "" — go test ignores dotted directories (.dark-factory/ is invisible to it).
#             Write a custom runner that symlinks scenario files into a valid Go package path,
#             then set SCENARIO_TEST_CMD to invoke that runner.
#   Rust:     "" — cargo test --test runs tests/*, not .dark-factory/scenarios/.
#             Write a custom runner for Rust scenarios and set SCENARIO_TEST_CMD to invoke it.
SCENARIO_TEST_CMD="__SCENARIO_TEST_CMD__"

# ==============================================================================
# Mutation Testing Command (optional — Gate 6)
# ==============================================================================
# Command to run mutation testing. Leave empty to skip.
#
# Examples:
#   Node/TS:  "npx stryker run"
#   Python:   "mutmut run"
#   Rust:     "cargo mutants"
MUTATION_CMD="__MUTATION_CMD__"

# ==============================================================================
# Timeouts (seconds)
# ==============================================================================
# Maximum time for individual quality gate commands (build, lint, test, etc.)
GATE_TIMEOUT="__GATE_TIMEOUT__"

# Maximum time for blind scenario execution
SCENARIO_TIMEOUT="__SCENARIO_TIMEOUT__"

# Maximum turns for Claude agent invocations (0 = no limit)
AGENT_MAX_TURNS="__AGENT_MAX_TURNS__"

# Retries for transient agent failures (timeout, crash, low output).
# Default: 1 (one retry = 2 total attempts). Set to 0 to disable.
AGENT_RETRIES="1"

# Minimum scenario pass rate (%) required for SHIP. Enforced by the orchestrator,
# not the Oracle. Set to 0 to disable (Oracle uses its own judgment).
MIN_SHIP_PASS_RATE="80"

# ==============================================================================
# Probabilistic Satisfaction Scoring
# ==============================================================================
# Multi-run execution: run each scenario file N times, pass if >= K succeed.
# Handles flaky tests by requiring consistent results rather than single-shot pass/fail.
# Set N > 1 to enable multi-run mode. N=1, K=1 is legacy single-run behavior.
SCENARIO_MULTI_RUN_N="1"
SCENARIO_MULTI_RUN_K="1"

# Minimum weighted satisfaction score (0-100) required for SHIP.
# 0 = disabled (legacy binary pass rate mode).
# Non-zero = enables weighted scoring where per-category pass rates are
# combined using the weights below. Both this floor and MIN_SHIP_PASS_RATE
# are enforced independently — failing either one blocks SHIP.
MIN_SATISFACTION_SCORE="0"

# Per-category scenario weights. Higher weight = more influence on the
# satisfaction score. Categories are identified by the NN- filename prefix
# convention used by the Scenario Architect (e.g., 01-contract.test.ts).
SCENARIO_WEIGHT_CONTRACT="100"       # 01- Contract tests
SCENARIO_WEIGHT_HAPPY_PATH="100"     # 02- Happy path tests
SCENARIO_WEIGHT_EDGE_CASES="80"      # 03- Edge case tests
SCENARIO_WEIGHT_ERROR_CONDITIONS="90" # 04- Error condition tests
SCENARIO_WEIGHT_STATE_SEQUENCE="80"  # 05- State & sequence tests
SCENARIO_WEIGHT_SECURITY="120"       # 06- Security tests (weighted higher)
SCENARIO_WEIGHT_PROPERTY_BASED="70"  # 07- Property-based tests
SCENARIO_WEIGHT_ADVERSARIAL="60"     # 08- Adversarial tests

# Trajectory plateau detection threshold (percentage points).
# Consecutive score changes within ±N are classified as PLATEAU.
TRAJECTORY_PLATEAU_THRESHOLD="5"

# Cumulative turn cap across all agent invocations in a run.
# Each agent invocation reserves AGENT_MAX_TURNS from this budget.
# Default: 0 (disabled). For cost control, use API-level spend limits
# at console.anthropic.com — this is a coarse proxy only.
# Note: retries may cause actual usage to exceed this budget.
MAX_TOTAL_AGENT_TURNS="0"

# Maximum wall-clock seconds per agent invocation
AGENT_TIMEOUT="__AGENT_TIMEOUT__"

# ==============================================================================
# Scenario Quality Validation
# ==============================================================================
# Validation mode: "strict" (halt on failure), "warn" (log and continue), "off" (skip)
SCENARIO_VALIDATION="__SCENARIO_VALIDATION__"

# Minimum number of scenario test files required
SCENARIO_MIN_FILES="__SCENARIO_MIN_FILES__"

# Minimum real assertion calls per scenario file
SCENARIO_MIN_ASSERTIONS_PER_FILE="__SCENARIO_MIN_ASSERTIONS_PER_FILE__"

# ==============================================================================
# Docker Isolation Settings
# ==============================================================================
# Colon-delimited list of source directories to mask from Scenario Architect.
# Each directory that exists will be hidden via tmpfs overlay in the SA container.
# SOURCE_DIR above is kept for backward compatibility in quality-gate.sh.
# Example: SOURCE_DIRS="src:lib:packages/core"
SOURCE_DIRS="__SOURCE_DIRS__"

# Implementer Write Scope (opt-in hardening)
# Colon-delimited directories the Implementer can write to.
# Default (empty or "."): full project write access.
# Scoped: "src:tests" restricts writes to src/ and tests/ (+ .dark-factory/reviews).
# WARNING: The Implementer may need to write root files (package.json, go.mod, etc.).
# Only scope writes if you are confident SOURCE_DIRS covers all needed paths.
IMPLEMENTER_WRITE_DIRS="__IMPLEMENTER_WRITE_DIRS__"

# Container resource limits
AGENT_MEMORY="__AGENT_MEMORY__"
AGENT_CPUS="__AGENT_CPUS__"

# Docker network name for pipeline containers (used only when egress filtering is disabled)
DOCKER_NETWORK="__DOCKER_NETWORK__"

# Disk I/O limits (opt-in, Linux-only — silently ignored on macOS Docker Desktop)
# Set AGENT_IO_DEVICE to the block device path (e.g., /dev/sda) to enable.
# AGENT_IO_DEVICE="/dev/sda"
# AGENT_IO_READ_BPS="100mb"
# AGENT_IO_WRITE_BPS="100mb"

# Egress filtering — restricts agent containers to allowlisted hosts only.
# Requires 'dark-factory-proxy' Docker image (built by docker/build-images.sh).
# Set to "false" only if you need to disable filtering (logs a startup warning).
EGRESS_FILTERING_ENABLED="true"

# ==============================================================================
# OAuth Token Expiry Tracking (optional)
# ==============================================================================
# If you authenticate via CLAUDE_CODE_OAUTH_TOKEN (Claude Pro/Max subscription),
# set this to your token's expiry date (1 year from 'claude setup-token').
# The pipeline will warn 30 days before expiry and block on the expiry date.
# Leave blank to disable expiry checks.
# Example: DF_TOKEN_EXPIRES="2027-03-02"
DF_TOKEN_EXPIRES=""

# ==============================================================================
# Ephemeral Deployment & LLM Evaluation (optional)
# ==============================================================================
# Deploy the application for behavioral evaluation. Leave empty to skip.
#
# DEPLOY_CMD:              Command to start the application (runs via bash -c on host)
# DEPLOY_TEARDOWN_CMD:     Command to stop the application (runs via bash -c on host)
# DEPLOY_BASE_URL:         Base URL for health check and evaluator
# DEPLOY_HEALTH_TIMEOUT:   Seconds to wait for health check
# DEPLOY_HEALTH_ENDPOINT:  GET endpoint that returns 2xx when ready
#
# Example (docker-compose):
#   DEPLOY_CMD="docker compose -f docker-compose.test.yml up -d"
#   DEPLOY_TEARDOWN_CMD="docker compose -f docker-compose.test.yml down -v"
#   DEPLOY_BASE_URL="http://localhost:3000"
DEPLOY_CMD="__DEPLOY_CMD__"
DEPLOY_TEARDOWN_CMD="__DEPLOY_TEARDOWN_CMD__"
DEPLOY_BASE_URL="__DEPLOY_BASE_URL__"
DEPLOY_HEALTH_TIMEOUT="__DEPLOY_HEALTH_TIMEOUT__"
DEPLOY_HEALTH_ENDPOINT="__DEPLOY_HEALTH_ENDPOINT__"

# ==============================================================================
# Cross-Spec Regression Testing
# ==============================================================================
# Run scenarios from previously-shipped specs after a SHIP decision to catch regressions.
# Can also be triggered with --regression flag.
REGRESSION_ON_SHIP="__REGRESSION_ON_SHIP__"

# Maximum seconds for regression test suite (all specs combined)
REGRESSION_TIMEOUT="__REGRESSION_TIMEOUT__"

# ==============================================================================
# Autonomy Level (progressive trust)
# ==============================================================================
# Controls how much human oversight the pipeline requires.
#   1 = Assisted:   Pipeline pauses after Oracle SHIP for human confirmation
#   2 = Supervised: Auto-proceed, log decision, track pass-rate metrics
#   3 = Autonomous:  Full dark factory — no human in the loop after spec phase
AUTONOMY_LEVEL="__AUTONOMY_LEVEL__"

# ==============================================================================
# CI/CD Closed-Loop Integration
# ==============================================================================
# Automatically create a PR after Oracle SHIP decision.
# Can be overridden with --auto-pr or --no-pr CLI flags.
AUTO_PR="__AUTO_PR__"

# Git remote to push branches to (default: origin)
GIT_REMOTE="__GIT_REMOTE__"

# Base branch for PRs (default: main)
GIT_BASE_BRANCH="__GIT_BASE_BRANCH__"

# Add PR to GitHub merge queue after creation.
# Requires repository-level merge queue configuration.
MERGE_QUEUE_ENABLED="__MERGE_QUEUE_ENABLED__"

# Skip git hooks on commits (--no-verify). Only enable if hooks
# conflict with automated commits. Default: false.
GITOPS_SKIP_HOOKS="__GITOPS_SKIP_HOOKS__"

# ==============================================================================
# Notifications
# ==============================================================================
# Slack incoming webhook URL for pipeline notifications.
# Leave empty to disable Slack notifications.
NOTIFY_SLACK_WEBHOOK_URL="__NOTIFY_SLACK_WEBHOOK_URL__"

# Generic webhook URL (receives JSON POST for all events).
# Leave empty to disable.
NOTIFY_WEBHOOK_URL="__NOTIFY_WEBHOOK_URL__"

# ==============================================================================
# Dark Factory Home (framework location)
# ==============================================================================
# Path to the dark-factory framework directory, relative to project root.
# Used to locate agent definitions, templates, and scripts.
DARK_FACTORY_HOME="__DARK_FACTORY_HOME__"
